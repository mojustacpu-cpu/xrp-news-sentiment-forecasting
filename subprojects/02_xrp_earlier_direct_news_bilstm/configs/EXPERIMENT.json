{
  "name": "02_xrp_earlier_direct_news_bilstm",
  "title": "XRP earlier eight-news-input BiLSTM (E1)",
  "target": "log_return",
  "features": [
    "EMA_20",
    "MACD_Signal",
    "SMA_20",
    "SMA_10",
    "EMA_10",
    "Volatility_10",
    "MACD",
    "MFI",
    "OBV",
    "BTC_Close",
    "open",
    "high",
    "low",
    "close",
    "volume",
    "return",
    "volatility",
    "price_sma10",
    "price_sma20",
    "sentiment",
    "stance_xrp",
    "uncertainty",
    "xrp_specificity",
    "news_present",
    "reg_access_flag",
    "surprise_flag",
    "sentiment_decay24_hl12"
